<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <gazebo reference="lidar_link">
        <sensor name="scan" type="gpu_lidar"> 
            <pose>0 0 0 0 0 0</pose>
            <topic>/model/$(arg robot_name)/lidar_scan</topic>
            <update_rate>10</update_rate>
            <always_on>1</always_on>
            <visualize>true</visualize>
            <ignition_frame_id>lidar_sim_frame</ignition_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>640</samples>
                        <resolution>1</resolution>
                        <min_angle>-1.396263</min_angle>
                        <max_angle>1.396263</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>1</resolution> <!-- 对于2D激光雷达，通常为1 -->
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan> 
                <range>
                    <min>0.08</min>
                    <max>10.0</max>
                    <resolution>0.01</resolution> <!-- 距离测量的精度 -->
                </range>
                <noise> 
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>
</robot>